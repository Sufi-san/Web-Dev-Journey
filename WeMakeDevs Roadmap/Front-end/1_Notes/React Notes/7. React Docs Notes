		    showNotification('Connected!', theme);	// will always have latest value of 'theme' prop
		  });

		  useEffect(() => {
		    const connection = createConnection(serverUrl, roomId);
		    connection.on('connected', () => {	// event handler assigned on last roomId change
		      onConnected();
		    });
		    connection.connect();
		    return () => connection.disconnect();
		  }, [roomId]);  // no need to inclue 'theme' or 'onConnected' here

		  return <h1>Welcome to the {roomId} room!</h1>
